{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noUncheckedIndexedAccess": false,
    "types": ["react", "node"]
  },
  "include": ["index.ts", "App.tsx", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
}
